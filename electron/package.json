{
  "name": "goatcad",
  "version": "0.1.18",
  "license": "GPL-3.0-or-later",
  "description": "A modern, integrated ECAD IDE for KiCad hardware designs",
  "main": "./out/main/index.js",
  "author": "Goat Hill Electronics LLC",
  "homepage": "https://goatcad.com",
  "desktopName": "com.goatcad.app",
  "scripts": {
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false --incremental --tsBuildInfoFile node_modules/.cache/tsc-node.tsbuildinfo",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false --incremental --tsBuildInfoFile node_modules/.cache/tsc-web.tsbuildinfo",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:i18n": "vitest run --config vitest.i18n.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:bundle": "electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "occt-import-js": "^0.0.23",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/node": "^26.4.1",
    "@types/tar": "^7.0.87",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@webgpu/types": "^0.1.71",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "^3.3.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
