{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goatcad-web",
  "compatibility_date": "2026-07-16",

  // Assets-only Worker: no "main". The site is fully static, and `main` is
  // optional when `assets` is configured, so there is no Worker script at all.
  // Note the enum values are hyphenated — the underscore spellings that appear
  // in some docs pages are silently ignored.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "routes": [
    { "pattern": "goatcad.com", "custom_domain": true },
    { "pattern": "www.goatcad.com", "custom_domain": true }
  ]
}
