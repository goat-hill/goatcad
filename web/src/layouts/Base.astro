---
import '../styles/global.css'
import { PRODUCT_NAME, TAGLINE, SITE_URL } from '../brand'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import {
  LOCALES,
  LOCALE_STORAGE_KEY,
  OG_LOCALES,
  fmt,
  homePath,
  homePaths,
  strings,
  type Locale
} from '../i18n'

interface Props {
  title?: string
  description?: string
  /**
   * 'dark' (default) pins the page to the dark palette — the landing page is a
   * designed dark surface and the hero art assumes it. 'auto' opts the page
   * into light/dark: it follows the OS preference, with a saved toggle choice
   * overriding that. Docs use 'auto'.
   */
  colorScheme?: 'dark' | 'auto'
  /** The page's language. Only the landing page has more than English. */
  locale?: Locale
  /**
   * The page exists in every locale (the landing page): emit hreflang
   * alternates and show the language switcher. Other pages are English only.
   */
  translated?: boolean
}

const { title, colorScheme = 'dark', locale = 'en', translated = false } = Astro.props
const s = strings(locale)
const description = Astro.props.description ?? fmt(s.meta.description)

// Home gets "GoatCAD — <HOME_TITLE>"; sub-pages get "Page — GoatCAD". A title
// is a label, and search engines truncate around 60 chars — even the tagline
// was cut there, so the home title has its own short phrase (brand.ts).
const pageTitle = title ? `${title} — ${PRODUCT_NAME}` : `${PRODUCT_NAME} — ${s.meta.homeTitle}`
const canonical = new URL(Astro.url.pathname, SITE_URL).href

// og.png, apple-touch-icon.png and favicon.png are generated by scripts/make-og-assets.mjs
// (see that file). The OG card is drawn from the brand — app icon, wordmark,
// tagline — rather than a screenshot, which is noise at link-preview size.
const ogImage = new URL('/og.png', SITE_URL).href
const ogImageAlt = fmt(s.meta.ogImageAlt, { tagline: TAGLINE })

// Every language's version of a translated page, plus x-default for visitors
// whose language is none of them (English, at `/`).
const alternates = translated
  ? [
      ...LOCALES.map((l) => ({ hreflang: l, href: new URL(homePath(l), SITE_URL).href })),
      { hreflang: 'x-default', href: new URL(homePath('en'), SITE_URL).href }
    ]
  : []

/*
 * Applies a saved theme choice before first paint, so a visitor who picked the
 * non-OS theme never sees a flash of the other one. The OS preference itself
 * needs no script — it is pure CSS in tokens.css — so with JS off an 'auto'
 * page still themes itself; it just cannot remember a manual override.
 *
 * Passed through set:html rather than written as an inline <script> inside the
 * conditional below: an inline script nested in an Astro expression is fragile
 * to parse (same reason DownloadButtons.astro hoists its script to the top
 * level). The key must match ThemeToggle.astro.
 */
/*
 * Sends a visitor who picked another language in the switcher from `/` to that
 * language's home, before first paint so English never flashes. Only the
 * English home does this, and only for a stored pick: crawlers have no
 * storage, a first visit is never redirected, and picking English stores 'en',
 * which stays put. Same set:html reason as THEME_INIT below.
 */
const LOCALE_REDIRECT =
  locale === 'en' && translated
    ? `try{var l=localStorage.getItem(${JSON.stringify(LOCALE_STORAGE_KEY)}),h=${JSON.stringify(homePaths())};if(l&&l!=='en'&&h[l])location.replace(h[l]+location.hash)}catch(e){}`
    : null

const THEME_INIT = `try{var t=localStorage.getItem('goatcad-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}`
---

<!doctype html>
<html lang={locale} data-color-scheme={colorScheme}>
  <head>
    <meta charset="utf-8" />
    {LOCALE_REDIRECT && <script is:inline set:html={LOCALE_REDIRECT} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {translated &&
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
      ))}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {colorScheme === 'auto' ? (
      <>
        <meta name="theme-color" content="#151c19" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#fbfcfb" media="(prefers-color-scheme: light)" />
        <script is:inline set:html={THEME_INIT} />
      </>
    ) : (
      <meta name="theme-color" content="#151c19" />
    )}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {s.nav.skip}
    </a>
    <Nav locale={locale} switcher={translated} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
