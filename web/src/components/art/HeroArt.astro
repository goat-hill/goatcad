---
/*
 * The hero motif: goats on San Francisco-style hills at golden hour, among
 * through-hole parts at boulder scale. Six little scenes, each with one idea
 * that plays out on hover (CSS; a tap on touch screens, see the script):
 *
 *   LED + resistor         light  — the LED switches on
 *   electrolytic + disc    joy    — the lookout on top wags its tail
 *   speaker + transistor   sound  — waves ripple out; nanny and kid look up
 *   pot + axial resistor   night  — the dial turns the sunset down to night
 *   antenna tower          radio  — waves broadcast from the mast
 *   nanny + kid            greet  — the kid turns, noses touch, tails wag
 *
 * Three rows: tower and sun on the far ridge; LED and the charging can on
 * the mid hill; pot, goats and speaker in the foreground.
 *
 * Each scene is a `.spot` group with an invisible `.hit` rect sized to the
 * scene, so a small part isn't a pixel-hunt. A scene plays while it is
 * hovered (only where the SVG has `.can-hover`) or while it has `.is-on`.
 * Touch screens have no hover, so the small inline script at the end turns
 * scenes on and off by tap and drops `.can-hover` there (so the browser's
 * sticky tap-hover can't hold a scene on). Without JS it's hover as before. The hero's art wrap is
 * pointer-events: none; spots opt back in. Reactions that land outside the
 * hovered group (goats, sun) go through `.hero-art:has(.spot-x:is(.is-on, .can-hover :hover))`.
 *
 * The parts are drawn like the goats: flat 2D side-view silhouettes, no
 * outlines or gradients, a body tone plus one detail tone, leads in dulled
 * copper. Anything shaded or 3D would sit apart from the goats.
 *
 * Keep notes here: template comments ship (WEB.md §2). Everything below is
 * plain SVG + CSS so the port into the app's WelcomeView stays a copy
 * (BRAND.md §4) — the frontmatter only computes coordinates and emits strings.
 *
 * The viewBox is wider than any hero, and the SVG is height-capped with
 * `xMidYMax slice`, so narrow screens crop the sides and wide ones crop sky:
 * the goats never balloon on a 4K monitor and never shrink to specks on a
 * phone. Anything that must survive the crop lives in the middle ~900 units.
 */

type Pt = [number, number]
type Seg = [number, number, number, number, number, number]
interface Ridge {
  start: Pt
  segs: Seg[]
}

const W = 1600
const H = 560

// Ridge lines, left to right, as cubic Béziers. Closed into a filled hill by
// `hill()`; sampled by `yAt()` so props and goats sit exactly on the surface.
const far: Ridge = {
  start: [0, 322],
  segs: [
    [70, 312, 120, 282, 168, 258],
    [196, 244, 222, 238, 246, 250],
    [262, 258, 272, 266, 290, 262],
    [312, 252, 330, 236, 356, 244],
    [400, 258, 440, 300, 540, 316],
    [660, 336, 800, 330, 920, 322],
    [1040, 314, 1110, 290, 1200, 282],
    [1290, 274, 1360, 296, 1450, 300],
    [1520, 303, 1570, 296, 1600, 294]
  ]
}

const mid: Ridge = {
  start: [0, 398],
  segs: [
    [60, 386, 120, 356, 196, 348],
    [262, 341, 322, 356, 384, 376],
    [470, 404, 570, 424, 700, 426],
    [830, 428, 930, 410, 1010, 380],
    [1080, 354, 1140, 324, 1236, 318],
    [1316, 313, 1362, 326, 1420, 342],
    [1486, 360, 1552, 362, 1600, 360]
  ]
}

const near: Ridge = {
  start: [0, 474],
  segs: [
    [120, 458, 250, 452, 370, 462],
    [490, 472, 570, 492, 710, 494],
    [850, 496, 960, 478, 1060, 452],
    [1116, 437, 1166, 426, 1226, 428],
    [1296, 430, 1360, 448, 1440, 464],
    [1520, 478, 1570, 480, 1600, 480]
  ]
}

const ridgePath = (r: Ridge): string =>
  `M${r.start.join(' ')} ` +
  r.segs.map((s) => `C${s.slice(0, 2)} ${s.slice(2, 4)} ${s.slice(4)}`).join(' ')

const hill = (r: Ridge): string => `${ridgePath(r)} L${W} ${H} L0 ${H} Z`

// Dense polyline of a ridge, for looking up the surface height at any x.
const sample = (r: Ridge): Pt[] => {
  const pts: Pt[] = [r.start]
  let [x0, y0] = r.start
  for (const [x1, y1, x2, y2, x3, y3] of r.segs) {
    for (let i = 1; i <= 64; i++) {
      const t = i / 64
      const u = 1 - t
      pts.push([
        u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3,
        u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3
      ])
    }
    ;[x0, y0] = [x3, y3]
  }
  return pts
}

const yAt = (pts: Pt[], x: number): number => {
  for (let i = 1; i < pts.length; i++) {
    const [ax, ay] = pts[i - 1]
    const [bx, by] = pts[i]
    if (x >= ax && x <= bx) return ay + ((x - ax) / (bx - ax)) * (by - ay)
  }
  return pts[pts.length - 1][1]
}

const farPts = sample(far)
const midPts = sample(mid)
const nearPts = sample(near)
const r1 = (n: number): number => Math.round(n * 10) / 10

// The goat, drawn facing right with its hooves on y = 0 and centered on x = 0.
// Inline rather than <use> so each goat's head, tail and stance are separate
// CSS animation targets. Far-side legs are a darker tone for depth. Two heads:
// alert (neck up) and grazing (neck reaching forward to the grass).
const HEAD_UP = `
    <path d="M5 -27 C8 -30 12 -35 15 -39 L18 -40 C21 -38 24 -35 26 -32 C27 -30.5 26 -29 24 -29.5 C22 -30 20 -31 18 -32 C16 -29 15 -25 14 -21 L8 -21 Z"></path>
    <path d="M14.2 -38.2 C13.6 -44 10.4 -47.6 6 -47.2 C9.8 -45.6 12.8 -42 16.8 -38.6 Z"></path>
    <path d="M15 -36 L9.5 -35 L15 -33.6 Z"></path>
    <path d="M23 -29.8 L22 -25.4 L21 -30.6 Z"></path>
    <circle class="eye" cx="19.5" cy="-36.4" r="0.9"></circle>
    <path class="eye-shut" d="M18.3 -36.8 q1.2 1.4 2.4 0"></path>`
const HEAD_GRAZE = `
    <path d="M4 -27.5 C10 -28 15.5 -24 18.5 -18.5 L21.5 -17 C24 -13 25.5 -8 26.5 -4.5 C27 -3 25.5 -2 24 -2.8 C22.5 -4 21.5 -6 20.5 -8 C18.5 -10.5 16 -14 14 -18 L8 -21 Z"></path>
    <path d="M18 -18.5 C16 -23.5 12 -25.5 8.5 -24.5 C12 -23 15 -21 20.5 -17.5 Z"></path>
    <path d="M19.5 -15 L14 -12.5 L19 -13 Z"></path>
    <path d="M23 -4.5 L19.5 -2 L22 -6 Z"></path>
    <circle class="eye" cx="21.6" cy="-12.6" r="0.9"></circle>
    <path class="eye-shut" d="M20.4 -13 q1.2 1.4 2.4 0"></path>`

// A grazer also carries an alert head, hidden until something startles it.
const goatHeads = (pose: 'up' | 'graze'): string =>
  pose === 'up'
    ? '<g class="head">' + HEAD_UP + '</g>'
    : '<g class="head">' + HEAD_GRAZE + '</g><g class="head-alert">' + HEAD_UP + '</g>'

const goatSvg = (pose: 'up' | 'graze'): string => `
  <g class="stance">
    <path class="far-legs" d="M13.5 -14 L14.5 0 M-14 -15 L-15.5 -7 L-14 0"></path>
    <path class="tail" d="M-21.2 -24.6 L-24.4 -30.8 L-22.4 -31.4 L-19 -25.4 Z"></path>
    <path d="M-21 -25.6 C-17 -28.4 -12.5 -28.2 -8 -27 C-2 -25.8 4 -26.8 8.5 -28.4 C13 -28.4 16 -24 16 -19 C16 -15 13 -13 10 -13 L5 -13 C-2 -12 -9 -12 -15 -13 C-19 -14 -22.5 -17 -22.5 -21 C-22.5 -23.6 -22.2 -25 -21 -25.6 Z"></path>
    <path class="legs" d="M10 -14 L10.5 0 M-18 -15 L-19.5 -7 L-18 0"></path>
    <path class="legs-folded" d="M9 -14.5 L10 -12 L18 -12.5 M-17 -14.5 L-21 -12 L-13 -11.5"></path>
    ${goatHeads(pose)}
  </g>
`

interface Goat {
  cls: string
  x: number
  y: number
  scale: number
  pose: 'up' | 'graze'
  flip?: boolean
  // How long after dusk this goat nods off (ms), so they don't drop in unison.
  nap: number
}

const goatTransform = (g: Goat): string =>
  `translate(${r1(g.x)} ${r1(g.y)}) scale(${g.flip ? -g.scale : g.scale} ${g.scale})`

// Where a sleeping goat's z's rise from: just above its tucked head. Drawn
// outside the goat so a flipped goat doesn't mirror its z's.
const zzzAt = (g: Goat): string =>
  `translate(${r1(g.x + (g.flip ? -1 : 1) * 14 * g.scale)} ${r1(g.y - 30 * g.scale)}) scale(${r1(g.scale)})`

// Parts stand in the pairs they're placed in on a real board. Each is drawn in
// local units with its seating plane on y = 0, then set on a ridge by `on()`.
const on = (pts: Pt[], x: number, scale = 1): string =>
  `translate(${x} ${r1(yAt(pts, x))})${scale === 1 ? '' : ` scale(${scale})`}`

// Spacing within a scene is one rule, not eyeballed: each part's outer
// extent [left, right] in local units, leads included, and every neighbour
// sits exactly GAP past the previous part's edge, scaled with the scene.
type Extent = [number, number]
const GAP = 12
const EXTENT: Record<string, Extent> = {
  led: [-14, 14],
  resStanding: [-7, 11],
  fence: [-34, 34],
  pot: [-13, 13],
  transistor: [-8, 8],
  speaker: [-9, 16],
  can: [-24, 24],
  disc: [-11, 11]
}
// Centers for a scene's parts, the whole scene (outer edge to outer edge)
// centered on cx.
const row = (cx: number, scale: number, parts: Extent[]): number[] => {
  const width = parts.reduce((w, [l, r]) => w + r - l, 0) + GAP * (parts.length - 1)
  let edge = cx - (width * scale) / 2
  return parts.map(([l, r]) => {
    const x = edge - l * scale
    edge += (r - l + GAP) * scale
    return r1(x)
  })
}

// Scenes are spread evenly across the view, not stacked into columns: each
// sits in its own stretch of the width, placed by rule rather than by eye.
// Pot and capacitor mirror at ±MID_STEP from the center (x = 800), the goats
// hold the center with the speaker FG_STEP to their right, and the LED fills
// the gap between the tower and the goats. The tower and sun are set by the
// ridge they stand on.
const CENTER = 800
const MID_STEP = 400
const FG_STEP = 180
const TOWER_X = 470
// The LED fills the widest gap left across the scene, halfway between the
// tower and the goats.
const LED_COL = (TOWER_X + CENTER) / 2

// A 5 mm LED, unlit (domed lens over a flange, the lead frame showing
// through), and beside it its current-limiting resistor, stood on end with the
// top lead hairpinned down, the way it goes into a tight board.
const [LED_X, LED_RES_X] = row(LED_COL, 1.25, [EXTENT.led, EXTENT.resStanding])

// A small speaker and the TO-92 transistor that drives it, in the foreground
// right beside the nanny and kid. Drawn side-on as the universal speaker
// shape (magnet, flared cone, rim) facing left, so its sound goes at them.
const [BUZZER_X, TRANSISTOR_X] = row(CENTER + FG_STEP, 1, [EXTENT.speaker, EXTENT.transistor])

// A trimmer pot beside the axial-resistor fence: turn it down and it's night.
// It keeps its distance from the goats and speaker, out in the left column
// that mirrors the capacitor's.
const [FENCE_X, POT_X] = row(CENTER - MID_STEP, 1, [EXTENT.fence, EXTENT.pot])

// The electrolytic can the lookout stands on, with its disc decoupling cap,
// on the crest of the mid hill — drawn at CAP_S since it's further off.
// The can is drawn centered on x = 0.
const CAP = { w: 48, h: 58 }
const CAP_S = 0.8
// The can's body, drawn from x = 0: a rounded rectangle pinched in near the
// bottom by the crimp that seals the rubber bung in.
const CAN_CRIMP = { y: -17, half: 4, depth: 3.5 }
const canBody = (() => {
  const { w, h } = CAP
  const [top, bottom, r] = [-h - 4, -8, 3]
  const { y, half, depth } = CAN_CRIMP
  return (
    `M${r} ${top} H${w - r} A${r} ${r} 0 0 1 ${w} ${top + r} V${y - half}` +
    ` Q${w - depth * 2} ${y} ${w} ${y + half} V${bottom - r} A${r} ${r} 0 0 1 ${w - r} ${bottom}` +
    ` H${r} A${r} ${r} 0 0 1 0 ${bottom - r} V${y + half} Q${depth * 2} ${y} 0 ${y - half}` +
    ` V${top + r} A${r} ${r} 0 0 1 ${r} ${top} Z`
  )
})()
const [CAP_X, DECOUPLE_X] = row(CENTER + MID_STEP, CAP_S, [EXTENT.can, EXTENT.disc])

const goats: Goat[] = [
  // The lookout, on top of the electrolytic can on the mid hill's crest.
  {
    cls: 'goat-lookout',
    x: CAP_X,
    y: yAt(midPts, CAP_X) - (CAP.h + 4) * CAP_S,
    scale: 1.35 * CAP_S,
    pose: 'up',
    nap: 0
  },
  // A nanny grazing with her kid in the foreground valley.
  // The pair together spans ~742–860: centered on the grid's middle column.
  {
    cls: 'goat-graze',
    x: CENTER + 28,
    y: yAt(nearPts, CENTER + 28) + 2,
    scale: 1.4,
    pose: 'graze',
    flip: true,
    nap: 450
  },
  {
    cls: 'goat-kid',
    x: CENTER - 36,
    y: yAt(nearPts, CENTER - 36) + 2,
    scale: 0.85,
    pose: 'up',
    flip: true,
    nap: 900
  }
]

// One axial resistor body for both resistors, whichever way it lies: drawn
// lying along x, centered on the origin, 40 long, in on-screen units. End caps
// bulge past the middle; three value bands at one end, tolerance at the other.
const roundRect = (x: number, y: number, w: number, h: number, r: number): string =>
  `M${x + r} ${y} H${x + w - r} A${r} ${r} 0 0 1 ${x + w} ${y + r} V${y + h - r}` +
  ` A${r} ${r} 0 0 1 ${x + w - r} ${y + h} H${x + r} A${r} ${r} 0 0 1 ${x} ${y + h - r}` +
  ` V${y + r} A${r} ${r} 0 0 1 ${x + r} ${y} Z`
const RES_BODY = [
  roundRect(-20, -7.5, 12, 15, 6),
  roundRect(8, -7.5, 12, 15, 6),
  'M-10 -5.5 H10 V5.5 H-10 Z'
].join(' ')
const RES_BANDS = 'M-14 -7.5 V7.5 M-5 -5.5 V5.5 M1 -5.5 V5.5 M14 -7.5 V7.5'

// The fence rail: lying on its side, its leads bent down into the ground on
// a round bend, the way pliers leave them.
const res = { cx: FENCE_X, cy: r1(yAt(nearPts, FENCE_X) - 15) }
const LEAD_BEND = 6
const [leadL, leadR] = [FENCE_X + EXTENT.fence[0], FENCE_X + EXTENT.fence[1]]
const resLeads = [
  `M${leadL} ${r1(yAt(nearPts, leadL) + 4)} V${res.cy + LEAD_BEND}`,
  `A${LEAD_BEND} ${LEAD_BEND} 0 0 1 ${leadL + LEAD_BEND} ${res.cy} H${res.cx - 20}`,
  `M${res.cx + 20} ${res.cy} H${leadR - LEAD_BEND}`,
  `A${LEAD_BEND} ${LEAD_BEND} 0 0 1 ${leadR} ${res.cy + LEAD_BEND} V${r1(yAt(nearPts, leadR) + 4)}`
].join(' ')

// Golden hour: the sun half-set behind the far ridge, right of center, with a
// wide warm glow on the horizon. It's the light source the rest of the scene
// answers to: backlit fog, the tower in silhouette.
const SUN = { x: 1020, y: r1(yAt(farPts, 1020) - 12) }

// Antenna tower on the far ridge's shoulder, drawn after Sutro Tower: legs
// splayed at the ground taper to a narrow waist, flare a little to a wide
// crossarm, and carry on straight up as three masts. Crossbars tie the legs
// low, at the waist, and at a pale platform above it. Seen side-on, the third
// leg stands in the middle, its mast the tallest. The legs are painted in
// long white runs with red around every joint.
// The ridge slopes under it, so each leg runs down to its own foot, buried
// below the surface; the tower is drawn behind the hill so the ground covers
// where the legs go in. Crossbars hang off the highest ground point.
const tower = { x: TOWER_X, base: r1(Math.min(yAt(farPts, 450), yAt(farPts, 490))) }
const towerTop = tower.base - 120
const centerTop = towerTop - 6
const towerFeet = [-15, 0, 15].map((dx) => r1(yAt(farPts, tower.x + dx) + 8))

// Every crossbar and band sits exactly on the legs: the outer legs run from
// their feet (x = ±15) to the waist (x = ±5), then flare to the crossarm
// (x = ±11), so points on them are found rather than drawn at a fixed width.
const FOOT = 15
const WAIST = 5
const ARM = 11
const waistY = tower.base - 56
const armY = tower.base - 86
const legX = (side: -1 | 1, y: number): number => {
  if (y < waistY) return r1(side * (WAIST + ((waistY - y) / (waistY - armY)) * (ARM - WAIST)))
  const foot = side < 0 ? towerFeet[0] : towerFeet[2]
  return r1(side * (FOOT - ((y - foot) / (waistY - foot)) * (FOOT - WAIST)))
}
// A run of an outer leg between two heights, bent at the waist if it spans it.
const legRun = (side: -1 | 1, lo: number, hi: number): string => {
  const ys = lo > waistY && hi < waistY ? [lo, waistY, hi] : [lo, hi]
  return 'M' + ys.map((y) => `${legX(side, y)} ${r1(y)}`).join(' L')
}
const lowBarY = tower.base - 30
const platformY = tower.base - 72
// Crossbars reach a little past the legs, like the real one's box trusses.
const bar = (y: number, over: number): string => `M${legX(-1, y) - over} ${y} H${legX(1, y) + over}`
const towerRedBars = [bar(lowBarY, 3), bar(waistY, 3), `M${-ARM - 11} ${armY} H${ARM + 11}`].join(
  ' '
)
const towerPlatform = bar(platformY, 3)
// The legs whole, in white; the red is laid over them at each joint.
const towerLegs = [
  legRun(-1, towerFeet[0], armY),
  legRun(1, towerFeet[2], armY),
  `M0 ${towerFeet[1]} V${armY}`
].join(' ')
const RED_SPANS: [number, number][] = [
  [tower.base + 24, tower.base - 8],
  [lowBarY + 7, lowBarY - 9],
  [waistY + 6, waistY - 7],
  [armY + 7, armY]
]
const towerLegRed = RED_SPANS.flatMap(([lo, hi]) => [
  legRun(-1, lo, hi),
  legRun(1, lo, hi),
  `M0 ${lo} V${hi}`
]).join(' ')
// Masts above the crossarm: thin, banded red and white by dashes.
const towerMasts = [
  `M${-ARM} ${armY} V${towerTop}`,
  `M${ARM} ${armY} V${towerTop}`,
  `M0 ${armY} V${centerTop}`
].join(' ')

// Hover targets, in viewBox units: [x, y, w, h] around each scene.
const nearY = (x: number): number => r1(yAt(nearPts, x))
const midY = (x: number): number => r1(yAt(midPts, x))
const hit = {
  led: [LED_X - 24, midY(LED_X) - 72, LED_RES_X - LED_X + 46, 80],
  lookout: [CAP_X - 30, midY(CAP_X) - (CAP.h + 4) * CAP_S - 62, DECOUPLE_X - CAP_X + 50, 136],
  buzzer: [BUZZER_X - 28, nearY(BUZZER_X) - 58, TRANSISTOR_X - BUZZER_X + 40, 64],
  pot: [leadL - 8, res.cy - 33, POT_X - leadL + 28, nearY(POT_X) - res.cy + 39],
  tower: [tower.x - 34, towerTop - 24, 68, tower.base - towerTop + 28],
  goats: [CENTER - 60, nearY(CENTER) - 64, 136, 70]
}

// Fixed-seed pseudo-random in [0, 1): stable between builds, so the art never
// shifts from one deploy to the next.
const hash = (n: number): number => {
  const v = Math.sin(n * 12.9898 + 78.233) * 43758.5453
  return v - Math.floor(v)
}

// The sky turns as one, the way the real one does: sun, glow and stars
// rotate SKY_TURN about a single pivot far up and to the right (the
// celestial pole, for someone facing west). So the sun sets down and to the
// right at a slant — about 20° off vertical, a touch gentler than San
// Francisco's true ~38°, which read as too steep a slide — and the stars
// wheel into place along the same arc. The moon makes its own entrance. CSS applies the
// turn; the numbers live here and reach CSS as custom properties.
const SKY_PIVOT = { x: 2570, y: -266 }
const SKY_TURN = -3
const turn = ([x, y]: number[], deg: number): number[] => {
  const a = (deg * Math.PI) / 180
  const dx = x - SKY_PIVOT.x
  const dy = y - SKY_PIVOT.y
  return [
    r1(SKY_PIVOT.x + dx * Math.cos(a) - dy * Math.sin(a)),
    r1(SKY_PIVOT.y + dx * Math.sin(a) + dy * Math.cos(a))
  ]
}
// Where something must be drawn by day so the night's turn lands it at p.
const beforeTurn = (p: number[]): number[] => turn(p, -SKY_TURN)

// Night sky, shown when the pot turns the sunset down: [x, y, r] where each
// star lands once the sky has turned. Scattered by the fixed hash, then kept
// out of the text column (x 520–1080), off the moon, and clear above the far
// ridge; drawn at its before-turn position.
const MOON = { x: 1330, y: 160 }
const stars: number[][] = Array.from({ length: 160 }, (_, i) => [
  r1(hash(i * 3 + 1) * W),
  r1(100 + hash(i * 3 + 2) * 190),
  r1(0.6 + hash(i * 3 + 3) ** 3 * 1.1)
])
  .filter(([x, y]) => x < 520 || x > 1080)
  .filter(([x, y]) => Math.hypot(x - MOON.x, y - MOON.y) > 38)
  .filter(([x, y]) => y < yAt(farPts, x) - 18)
  .slice(0, 46)
  .map(([x, y, r]) => [...beforeTurn([x, y]), r])

// Tufts of grass along the near ridge.
const tufts = [110, 210, 520, 620, 690, 900, 1080, 1180, 1330, 1470].map((x) => ({
  x,
  y: r1(yAt(nearPts, x) + 1)
}))

// Fog rolling over the hills, left to right like the marine layer coming in.
// Each bank is a cluster of soft billows (see `billows`), parked off the
// left edge and carried across by CSS. `over` is the ridge it drifts
// across: 'far' banks pass in front of the far ridge and tower, 'mid' banks in
// front of the mid hill, both behind the goats. `rest` is where a bank holds
// still under reduced motion.
interface FogBank {
  over: 'far' | 'mid'
  y: number
  rx: number
  ry: number
  dur: number
  delay: number
  rest: number
}
const FOG_START = -420
const fogBanks: FogBank[] = [
  { over: 'far', y: 262, rx: 230, ry: 32, dur: 150, delay: -40, rest: 640 },
  { over: 'far', y: 290, rx: 320, ry: 30, dur: 125, delay: -95, rest: 1500 },
  { over: 'far', y: 300, rx: 260, ry: 24, dur: 170, delay: -150, rest: 1100 },
  { over: 'mid', y: 352, rx: 300, ry: 28, dur: 140, delay: -20, rest: 1250 },
  { over: 'mid', y: 336, rx: 220, ry: 22, dur: 185, delay: -120, rest: 1850 }
]
// A bank is a row of round billows over a flat base: tallest mid-bank, each
// billow sized by a fixed hash so the tops are lumpy but stable between
// builds. The lumpy top is what reads as a cloud rolling over a hill; a single
// stretched ellipse reads as smog.
const billows = (b: FogBank, seed: number): number[][] => {
  const n = Math.max(3, Math.round((2 * b.rx) / 120))
  const puffs = Array.from({ length: n }, (_, i) => {
    const t = i / (n - 1)
    const r = b.ry * (1.1 + 1.3 * Math.sin(Math.PI * t)) * (0.85 + 0.3 * hash(seed * 31 + i))
    return [r1((-b.rx + t * 2 * b.rx) * 0.8), r1(b.ry * 0.35 - r * 0.45), r1(r * 1.5), r1(r)]
  })
  return [[0, r1(b.ry * 0.35), b.rx, r1(b.ry * 0.7)], ...puffs]
}
const fogFor = (over: FogBank['over']): FogBank[] => fogBanks.filter((b) => b.over === over)
