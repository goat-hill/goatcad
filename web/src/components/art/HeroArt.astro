<script>
  // Touch screens have no hover: a tap turns a hover scene on (tap it again,
  // or anywhere else, to turn it off; one at a time). Where hover exists this
  // does nothing, and without JS the scenes are hover-only as before.
  ;(() => {
    if (!matchMedia('(hover: none)').matches) return
    const art = document.querySelector('.hero-art')
    if (!art) return
    art.classList.remove('can-hover')
    let on: Element | null = null
    const set = (spot: Element | null) => {
      if (on) on.classList.remove('is-on')
      on = spot && spot !== on ? spot : null
      if (on) on.classList.add('is-on')
    }
    // Listening on each scene (not just the document) is what makes iOS
    // treat the SVG groups as tappable.
    for (const spot of art.querySelectorAll('.spot')) {
      spot.addEventListener('click', () => set(spot))
    }
    document.addEventListener('pointerdown', (e) => {
      if (on && !on.contains(e.target as Node)) set(null)
    })
  })()
</script>

<style>
  /* Colors: golden hour on the forest family (BRAND.md §2). The
     top of the scene stays page-dark so it meets the text above; the land
     lifts into real greens toward the horizon glow. Copper only through
     --accent: the glow, sun, sound waves and fog tint all mix from it. The landing
     page is pinned dark, so the land tones are literal values. */
  .hero-art {
    display: block;
    width: 100%;
    height: clamp(190px, 40vw, 640px);
    --ha-far-top: #33463b;
    --ha-far-bottom: #2a3b32;
    --ha-mid-top: #243429;
    --ha-mid-bottom: #1e2c24;
    --ha-near-top: #1a261f;
    --ha-near-bottom: #151c19;
    --ha-warm: color-mix(in srgb, var(--accent) 60%, #c5d3cd);
    --ha-glow: var(--accent);
    --ha-sun: color-mix(in srgb, var(--accent) 55%, #fff4dc);
    --ha-fog: color-mix(in srgb, var(--accent) 22%, #ffffff);
    /* Sutro's international orange, dulled by distance and dusk: the copper
       accent pulled toward brick red, then into the far ridge's green. */
    --ha-tower: color-mix(
      in srgb,
      color-mix(in srgb, var(--accent) 30%, #b0341f) 62%,
      var(--ha-far-top)
    );
    --ha-tower-white: color-mix(in srgb, var(--ha-goat) 42%, var(--ha-far-top));
    --ha-tuft: #4f6653;
    --ha-goat: #e6dece;
    --ha-goat-far: #a59d8b;
    --ha-goat-brown: #a07d5a;
    --ha-goat-brown-far: #6f5840;
    /* One tone for every part, near or far: a gray-green a step lighter
       than every hill it stands on, so the parts read against all of them. */
    --ha-part: #45544c;
    --ha-part-shade: #323e38;
    --ha-part-light: #7a8b81;
    --ha-lead: color-mix(in srgb, var(--accent) 55%, #151c19);
    /* When the first sound wave is up (see .wave): the goats hear it then. */
    --hear: 320ms;
    /* How long a goat takes to notice the LED come on. */
    --notice: 250ms;
    /* When the sun is down and the goats settle for the night. */
    --dusk: 1000ms;
  }

  /* Phones: simplify rather than shrink. Shrunk whole, the scene is specks.
     Instead show its middle — tower to lookout, x ≈ 350–1330, leaving each
     a margin from the screen edge — at well over the shrunk size. The SVG is
     sized wider than the screen and shifted; the hero clips it. */
  @media (max-width: 600px) {
    .hero-art {
      /* global.css caps svg at 100% width; this crop needs it wider. */
      max-width: none;
      width: calc(100vw * 1600 / 980);
      height: auto;
      aspect-ratio: 1600 / 560;
      margin-left: calc(-100vw * 350 / 980);
    }
    /* The pot scene sits at the crop's left edge, so on phones it steps in
       toward the goats — night is the best scene, and on a phone it's a tap
       away. */
    .spot-pot {
      transform: translate(100px, 13px);
    }
    /* The moon sits right at the crop's edge, and the top of the art is
       under the text here: step it in and down, beside the lookout. */
    .moon-spot {
      transform: translate(1272px, 222px);
    }
  }

  .stop-far-top {
    stop-color: var(--ha-far-top);
  }
  .stop-far-bottom {
    stop-color: var(--ha-far-bottom);
  }
  .stop-mid-top {
    stop-color: var(--ha-mid-top);
  }
  .stop-mid-bottom {
    stop-color: var(--ha-mid-bottom);
  }
  .stop-near-top {
    stop-color: var(--ha-near-top);
  }
  .stop-near-bottom {
    stop-color: var(--ha-near-bottom);
  }

  .stop-glow,
  .stop-glow-mid,
  .stop-glow-edge {
    stop-color: var(--ha-glow);
    stop-opacity: 0.3;
  }
  .stop-glow-mid {
    stop-opacity: 0.1;
  }
  .stop-glow-edge {
    stop-opacity: 0;
  }
  .sun {
    fill: var(--ha-sun);
    opacity: 0.75;
  }

  /* Warm-white and backlit, so the fog glows rather than smothers. */
  .stop-fog,
  .stop-fog-mid,
  .stop-fog-edge {
    stop-color: var(--ha-fog);
    stop-opacity: 0.11;
  }
  .stop-fog-mid {
    stop-opacity: 0.05;
  }
  .stop-fog-edge {
    stop-opacity: 0;
  }

  .tower-legs,
  .tower-red,
  .tower-platform,
  .tower-bars,
  .tower-masts {
    fill: none;
    stroke: var(--ha-tower);
    stroke-width: 2.2;
    stroke-linecap: butt;
    stroke-linejoin: round;
  }
  .tower-legs,
  .tower-platform,
  .tower-masts {
    stroke: var(--ha-tower-white);
  }
  .tower-bars {
    stroke-width: 3;
  }
  .tower-platform {
    stroke-width: 2.4;
  }
  .tower-masts {
    stroke-width: 1.4;
  }
  .tower-masts-red {
    stroke: var(--ha-tower);
    stroke-dasharray: 5 5;
  }
  .beacon {
    fill: var(--accent);
    opacity: 0.6;
  }

  /* Parts: one shared flat recipe. */
  .part-body {
    fill: var(--ha-part);
  }
  .part-shade,
  .can-minus {
    fill: var(--ha-part-shade);
    stroke: var(--ha-part-shade);
  }
  .can-minus {
    stroke-width: 2;
  }
  .part-light {
    fill: var(--ha-part-light);
  }
  .part-lead {
    fill: none;
    stroke: var(--ha-lead);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .res-bands {
    stroke: var(--accent);
    stroke-width: 3;
    opacity: 0.5;
  }
  /* Ceramic discs: the same dulled amber family as the LED lens. */
  .disc-body {
    fill: color-mix(in srgb, var(--accent) 22%, var(--ha-part));
  }
  /* Unlit: amber gone dull, the way an LED looks with no current. */
  .led-lens {
    --led-off: color-mix(in srgb, var(--accent) 28%, var(--ha-part));
    --led-on: color-mix(in srgb, var(--accent) 70%, #fff4d6);
    fill: var(--led-off);
  }

  .tufts path {
    fill: none;
    stroke: var(--ha-tuft);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .goat {
    fill: var(--ha-goat);
  }
  .goat :global(.eye) {
    fill: #151c19;
  }
  .goat :global(.legs),
  .goat :global(.far-legs) {
    fill: none;
    stroke: var(--ha-goat);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .goat :global(.far-legs) {
    stroke: var(--ha-goat-far);
  }
  /* The nanny is brown; her kid and the lookout are cream. */
  .goat-graze {
    fill: var(--ha-goat-brown);
  }
  .goat-graze :global(.legs) {
    stroke: var(--ha-goat-brown);
  }
  .goat-graze :global(.far-legs) {
    stroke: var(--ha-goat-brown-far);
  }

  /* --- Hover scenes. Feedback lands at the app's ~70ms; anything that
     plays out (a hop, a sunrise) starts on that beat and runs its course. --- */
  .spot {
    pointer-events: auto;
  }
  .hit {
    fill: none;
    pointer-events: all;
  }

  /* Light: the LED powers on. A clean ramp, never a flicker (that reads as
     a failing part): the lens brightens from the first frame, and the halo
     swells into a bloom that slightly overshoots and settles, ~380ms end to
     end. Switching off is a plain fade. */
  .stop-halo {
    stop-color: var(--accent);
    stop-opacity: 0.55;
  }
  .stop-halo-edge {
    stop-color: var(--accent);
    stop-opacity: 0;
  }
  .led-halo {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition: opacity 400ms ease-out;
  }
  .led-lens {
    transition: fill 400ms ease-out;
  }
  .spot-led:is(.is-on, .can-hover :hover) .led-halo {
    opacity: 1;
    animation: ha-led-halo 380ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .spot-led:is(.is-on, .can-hover :hover) .led-lens {
    fill: var(--led-on);
    transition: fill 180ms ease-out;
  }
  @keyframes ha-led-halo {
    0% {
      opacity: 0.3;
      transform: scale(0.5);
    }
    60% {
