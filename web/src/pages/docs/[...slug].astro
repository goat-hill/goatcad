---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../layouts/DocsLayout.astro'

/*
 * One route renders every docs page. The rest param `[...slug]` lets the
 * `index` entry map to a bare `/docs` (params.slug === undefined) while every
 * other entry maps to `/docs/<id>`. Static output: all paths are enumerated at
 * build time from the collection, so there is no runtime routing.
 */
export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry }
  }))
}

const { entry } = Astro.props
// headings feed the sidebar's second level (jump-to-section under the current
// page) — the same data the removed on-this-page column used.
const { Content, headings } = await render(entry)

// The sidebar is the whole collection in schema order; DocsLayout marks the
// current page. Built here (not in the layout) so the layout stays a dumb shell.
const nav = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order)
---

<DocsLayout entry={entry} nav={nav} headings={headings}>
  <Content />
</DocsLayout>
